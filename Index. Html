            var isInApp = (
                ua.indexOf('FBAN') > -1 || 
                ua.indexOf('FBAV') > -1 || 
                ua.indexOf('Instagram') > -1 || 
                ua.indexOf('TikTok') > -1 || 
                ua.indexOf('ByteLocale') > -1 || 
                ua.indexOf('Musical_ly') > -1 || 
                ua.indexOf('Snapchat') > -1
            );

