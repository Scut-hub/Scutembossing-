<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title id="t_pageTitle">SCUT EMBOSSING | ورشة الأختام المعدنية والوسم الحراري بالجزائر</title>
    <!-- Google Fonts & FontAwesome -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&family=Poppins:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --primary: #d4af37;
            --primary-dark: #b89726;
            --primary-light: #fdfaf0;
            --accent-btn: #1e293b;
            --accent-btn-hover: #0f172a;
            --bg-color: #fafbfc;
            --card-bg: #ffffff;
            --text-color: #1a1a1a;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --border-light: #f1f5f9;
            --whatsapp-green: #25D366;
            --whatsapp-dark: #128C7E;
            --transition-smooth: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Cairo', 'Poppins', sans-serif;
            scroll-behavior: smooth;
            -webkit-tap-highlight-color: transparent;
            -webkit-touch-callout: none !important;
            -webkit-user-select: none;
            user-select: none;
            box-shadow: none !important;
            text-shadow: none !important;
        }

        html, body {
            width: 100%;
            margin: 0 !important;
            padding: 0 !important;
            overflow-x: hidden;
            background-color: var(--bg-color);
            color: var(--text-color);
            line-height: 1.6;
        }

        .main-wrapper {
            width: 100%;
            max-width: 100%;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
        }

        /* شريط تغيير اللغة بالأعلى */
        .top-lang-nav {
            display: flex;
            justify-content: flex-end;
            padding: 10px 16px;
            background: #ffffff;
            border-bottom: 1px solid var(--border-light);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .lang-switch-btn {
            background: #ffffff;
            border: 1.5px solid var(--primary);
            padding: 5px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.8rem;
            font-weight: 800;
            color: var(--primary-dark);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: var(--transition-smooth);
        }

        .lang-switch-btn:hover {
            background: var(--primary-light);
        }

        /* Top Warning Banner for In-App Browsers */
        .inapp-banner {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background: #111111;
            color: #ffffff;
            z-index: 999999;
            padding: 10px 16px;
            border-bottom: 2px solid var(--primary);
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            font-size: 0.85rem;
        }

        .inapp-banner-content {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 700;
        }

        .inapp-banner-content i {
            color: var(--primary);
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .inapp-close-btn {
            background: var(--primary);
            color: #ffffff;
            border: none;
            padding: 5px 12px;
            border-radius: 6px;
            font-weight: 800;
            font-size: 0.8rem;
            cursor: pointer;
            white-space: nowrap;
            flex-shrink: 0;
        }

        body.has-banner .hero {
            padding-top: 90px;
        }

        /* Hero Section */
        .hero {
            padding: 40px 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            background: #ffffff;
            border-bottom: 1px solid var(--border-light);
        }

        .hero-content {
            max-width: 750px;
            margin: 0 auto;
        }

        .badge {
            background: var(--primary-light);
            color: var(--primary-dark);
            border: 1px solid var(--border-light);
            padding: 5px 14px;
            border-radius: 6px;
            font-size: 0.8rem;
            font-weight: 800;
            display: inline-block;
            margin-bottom: 14px;
        }

        .hero-title {
            font-size: 1.6rem;
            font-weight: 900;
            line-height: 1.35;
            margin-bottom: 14px;
            color: #0f172a;
        }

        .hero-title span {
            color: var(--primary-dark);
        }

        .hero-desc {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-bottom: 20px;
            font-weight: 600;
            line-height: 1.7;
        }

        .hero-btns {
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn-whatsapp-main {
            background: var(--primary);
            color: #ffffff;
            padding: 10px 18px;
            border-radius: 6px;
            font-weight: 800;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.85rem;
            transition: var(--transition-smooth);
        }

        .btn-whatsapp-main:hover {
            background: var(--primary-dark);
        }

        /* زر حساب السعر الرئيسي بلون مختلف ومميز */
        .cta-btn {
            background: var(--accent-btn);
            color: #ffffff;
            padding: 10px 20px;
            border-radius: 6px;
            font-weight: 900;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.88rem;
            border: 1px solid var(--primary);
            transition: var(--transition-smooth);
        }

        .cta-btn:hover {
            background: var(--accent-btn-hover);
            border-color: var(--primary-dark);
        }

        .btn-gallery-outline {
            background: #ffffff;
            color: var(--primary-dark);
            padding: 10px 18px;
            border-radius: 6px;
            font-weight: 800;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.85rem;
            border: 1.5px solid var(--primary);
            transition: var(--transition-smooth);
        }

        .btn-gallery-outline:hover {
            background: var(--primary-light);
        }

        /* Stamps Grid Section */
        .section-title {
            text-align: center;
            padding: 30px 12px 15px;
        }

        .section-title h2 {
            font-size: 1.3rem;
            font-weight: 900;
            color: #0f172a;
        }

        .section-title p {
            color: var(--text-muted);
            margin-top: 4px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .stamps-grid {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 12px 40px;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            width: 100%;
        }

        @media (min-width: 768px) {
            .stamps-grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 18px;
                padding: 0 20px 50px;
            }
        }

        @media (min-width: 1024px) {
            .stamps-grid {
                grid-template-columns: repeat(4, 1fr);
                gap: 20px;
            }
        }

        .stamp-card {
            position: relative;
            background-color: #ffffff;
            border-radius: 8px;
            padding: 14px 10px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 190px;
            overflow: hidden;
            border: 1px solid var(--border-color);
            transition: var(--transition-smooth);
        }

        @media (min-width: 768px) {
            .stamp-card {
                padding: 20px 16px;
                height: 230px;
            }
        }

        .stamp-card-bg {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-size: cover;
            background-position: center;
            opacity: 0.98; /* أقصى وضوح ممكن للصور الخلفية */
            z-index: 1;
        }

        .stamp-card-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.20) 0%, rgba(255, 255, 255, 0.55) 100%); /* طبقة غلاف شفافة جداً لتبرز الصورة بكامل تفاصيلها ووضوحها */
            z-index: 2;
        }

        .stamp-card-content {
            position: relative;
            z-index: 3;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 100%;
        }

        .stamp-card:hover {
            border-color: var(--primary);
        }

        .stamp-card h3 {
            font-size: 0.9rem;
            font-weight: 900;
            margin-bottom: 4px;
            color: #0f172a;
            text-shadow: 0 1px 4px rgba(255, 255, 255, 1), 0 0 8px rgba(255, 255, 255, 0.8); /* ظل قوي ومدروس لضمان قراءة النص بوضوح تام فوق الصورة الساطعة */
            display: -webkit-box;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        @media (min-width: 768px) {
            .stamp-card h3 {
                font-size: 1.1rem;
                margin-bottom: 6px;
            }
        }

        .stamp-card p {
            color: #0f172a;
            font-size: 0.73rem;
            margin-bottom: 8px;
            font-weight: 800;
            line-height: 1.35;
            text-shadow: 0 1px 3px rgba(255, 255, 255, 1), 0 0 6px rgba(255, 255, 255, 0.8);
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        @media (min-width: 768px) {
            .stamp-card p {
                font-size: 0.82rem;
                margin-bottom: 12px;
            }
        }

        .stamp-card-btn {
            color: var(--primary-dark);
            text-decoration: none;
            font-weight: 900;
            font-size: 0.73rem;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(255, 255, 255, 0.95);
            border: 1px solid var(--border-color);
            padding: 5px 10px;
            border-radius: 6px;
            width: fit-content;
            transition: var(--transition-smooth);
        }

        @media (min-width: 768px) {
            .stamp-card-btn {
                font-size: 0.82rem;
                padding: 6px 12px;
            }
        }

        .stamp-card-btn:hover {
            border-color: var(--primary);
            background: var(--primary-light);
        }

        /* Social Icons & Contact Links */
        .social-links {
            display: flex;
            gap: 8px;
            margin-top: 12px;
            flex-wrap: wrap;
        }

        .social-btn {
            width: 36px;
            height: 36px;
            border-radius: 6px;
            background: #ffffff;
            border: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-color);
            text-decoration: none;
            font-size: 0.9rem;
            transition: var(--transition-smooth);
        }

        .social-btn:hover {
            border-color: var(--primary);
            color: var(--primary-dark);
        }

        /* Footer */
        footer {
            background: #ffffff;
            padding: 35px 16px 20px !important;
            border-top: 1px solid var(--border-light);
            margin-bottom: 0 !important;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 25px;
            margin-bottom: 25px;
            max-width: 1100px;
            margin-inline: auto;
        }

        .footer-col h4 {
            color: var(--primary-dark);
            font-size: 0.95rem;
            font-weight: 800;
            margin-bottom: 12px;
            border-bottom: 1px solid var(--border-light);
            padding-bottom: 6px;
        }

        .footer-col ul {
            list-style: none;
        }

        .footer-col ul li {
            margin-bottom: 8px;
        }

        .footer-col ul a {
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.82rem;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: var(--transition-smooth);
        }

        .footer-col ul a:hover {
            color: var(--primary-dark);
        }

        .footer-bottom {
            text-align: center;
            padding-top: 16px;
            border-top: 1px solid var(--border-light);
            color: var(--text-muted);
            font-size: 0.78rem;
            font-weight: 700;
        }
    </style>
</head>
